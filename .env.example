# ==========================================
# Secrets reference
# Production values live in Firebase Secret Manager:
#   firebase functions:secrets:set <NAME>
# For the local emulator, put them in functions/.secret.local (gitignored).
# Never commit real values.
# ==========================================

# Stripe — use a RESTRICTED key with only "Checkout Sessions: Write"
STRIPE_SECRET_KEY=rk_test_your_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Google Apps Script bridge (Sheets + Gmail)
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
APPS_SCRIPT_SECRET_TOKEN=generate_with_openssl_rand_hex_32

# Admin dashboard
ADMIN_PASSWORD=a_long_random_passphrase
